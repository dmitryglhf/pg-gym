-		}
-	}
-	else if (isinf(arg1))
-	{
-		if (arg2 == 0.0)
-			result = 1.0;
-		else if (arg1 > 0.0)	/* x = +Inf */
-		{
-			if (arg2 > 0.0)
-				result = arg1;
-			else
-				result = 0.0;
-		}
-		else					/* x = -Inf */
