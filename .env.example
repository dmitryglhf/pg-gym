# Infrastructure configuration for manually started API/worker processes.
# Compose instances use platform.env generated by pg-gym platform init.
PG_GYM_ORIGIN=http://localhost:8000
PG_GYM_DATA=./var/platform
PG_GYM_SECRET_DIR=./var/secrets
PG_GYM_API_URL=http://127.0.0.1:8001
PG_GYM_WORKER_DATA=./var/worker
PG_GYM_WORKER_ID=local
PG_GYM_SECURE_COOKIE=0
PG_GYM_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# Put account model keys in Settings. Operator secrets are read from files
# named worker-token, registration-token, and master.key in PG_GYM_SECRET_DIR.
